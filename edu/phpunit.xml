<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Pinned to a bare origin on purpose. A path here (as in
             APP_URL=https://dev.bkesari.com/edu, which is how this app is
             published under the hub) makes AppServiceProvider pin the URL
             generator's root to it, and the test client builds its request
             URLs with url(), so every $this->get('/login') would ask for
             /edu/login — a path no route matches, because in production the
             hub strips the prefix before the app sees it and in a test there
             is no hub. Without this the suite would pass or fail depending on
             a developer's .env. The prefixed behaviour has its own coverage in
             tests/Feature/Platform/BasePathTest.php. -->
        <env name="APP_URL" value="http://localhost"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Zero-setup default: in-memory SQLite. These do not override variables
             already set in the environment, so CI (and TESTING.md) run the same
             suite against PostgreSQL by exporting DB_CONNECTION=pgsql and the
             other DB_* variables. PostgreSQL is the only production database. -->
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <!-- Pinned like DB_URL, so a DB_URL_UNPOOLED line in .env (the direct
             Neon endpoint, on a server) is never read by a test run. -->
        <env name="DB_URL_UNPOOLED" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
