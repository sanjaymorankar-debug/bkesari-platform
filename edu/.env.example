APP_NAME="Education Accountability Platform"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# APP_URL carries the path this app is published under, and it is load-bearing
# — not cosmetic. On bkesari.com this app is the Education tab at /edu/, so:
#
#   APP_URL=https://dev.bkesari.com/edu
#
# The hub forwards those requests with the /edu prefix removed (Laravel matches
# routes against the request path, and public/ is served from this site's own
# root), so the app answers at its root and puts the prefix back on every URL it
# writes. That is driven entirely by the path here. Get it wrong and the pages
# still load while every link, asset and sign-in post goes to the wrong place.
#
# Serving this app at a domain of its own instead? Then leave the path off and
# none of that happens:
#
#   APP_URL=https://edutest.agtci.com
#
APP_URL=https://dev.bkesari.com/edu

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# PostgreSQL (the only supported database). Requires the pdo_pgsql PHP extension.
# Production: use the host/port/credentials of your managed PostgreSQL instance
# and set DB_SSLMODE=require (or verify-full) when connecting over the network.
# See DEPLOYMENT.md — Hostinger shared/cloud web hosting does not provide PostgreSQL.
# Locally, tools/setup_local_postgres.sh (repo root) fills these in for you.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bk_edu
DB_USERNAME=bk_edu
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@edutest.agtci.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
