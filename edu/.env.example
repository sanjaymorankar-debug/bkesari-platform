APP_NAME="Education Accountability Platform"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# APP_URL carries the path this app is published under, and it is load-bearing
# — not cosmetic. On bkesari.com this app is the Education tab at /edu/, so:
#
#   APP_URL=https://dev.bkesari.com/edu
#
# The hub forwards those requests with the /edu prefix removed (Laravel matches
# routes against the request path, and public/ is served from this site's own
# root), so the app answers at its root and puts the prefix back on every URL it
# writes. That is driven entirely by the path here. Get it wrong and the pages
# still load while every link, asset and sign-in post goes to the wrong place.
#
# Serving this app at a domain of its own instead? Then leave the path off and
# none of that happens:
#
#   APP_URL=https://edutest.agtci.com
#
APP_URL=https://dev.bkesari.com/edu

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# PostgreSQL (the only supported database). Requires the pdo_pgsql PHP extension.
#
# On every bkesari.com tier the database is Neon (../docs/NEON.md): database
# `bk_edu`, owned by the login `bk_edu_app`, on that tier's Neon branch. The
# server's .env then holds that tier's two connection strings, pasted whole
# from the Neon console (Connect -> database bk_edu, role bk_edu_app),
# ?sslmode=require&channel_binding=require included, and nothing else from the
# DB_HOST..DB_SSLMODE block below:
#
#   DB_CONNECTION=pgsql
#   DB_URL=postgresql://bk_edu_app:<password>@ep-<id>-pooler.<region>.aws.neon.tech/bk_edu?sslmode=require&channel_binding=require
#   DB_URL_UNPOOLED=postgresql://bk_edu_app:<password>@ep-<id>.<region>.aws.neon.tech/bk_edu?sslmode=require&channel_binding=require
#
# DB_URL ("Connection pooling" on) is what the app uses while it runs.
# DB_URL_UNPOOLED ("Connection pooling" off) is used by `php artisan migrate`,
# `db:seed` and the other schema commands, automatically. Either one overrides
# the DB_* lines below. After changing them on a server, run
# `php artisan config:cache` again (or `optimize`): the cached copy is what the
# app reads.
#
# Locally, leave both unset and use the DB_* lines; tools/setup_local_postgres.sh
# (repo root) fills them in for you.
DB_CONNECTION=pgsql
DB_URL=
DB_URL_UNPOOLED=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bk_edu
DB_USERNAME=bk_edu
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@edutest.agtci.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# The bkesari.com hub's key set: signs visitors in from its X-Bkesari-Token.
# e.g. https://dev.bkesari.com/.well-known/jwks.json (same tier as APP_URL)
HUB_JWKS_URL=
