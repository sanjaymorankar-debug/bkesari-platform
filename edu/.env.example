APP_NAME="Education Accountability Platform"
# The tier: dev on devedu.bkesari.com, test on testedu.bkesari.com, production
# on edu.bkesari.com (local on your own machine). Only local and dev may show a
# sign-in code on screen, and only with no working mailer (MAIL_* below).
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# APP_URL carries the path this app is published under, and it is load-bearing
# — not cosmetic. On bkesari.com this app is the Education tab at /edu/, so:
#
#   APP_URL=https://dev.bkesari.com/edu
#
# The hub forwards those requests with the /edu prefix removed (Laravel matches
# routes against the request path, and public/ is served from this site's own
# root), so the app answers at its root and puts the prefix back on every URL it
# writes. That is driven entirely by the path here. Get it wrong and the pages
# still load while every link, asset and sign-in post goes to the wrong place.
#
# Serving this app at a domain of its own instead? Then leave the path off and
# none of that happens:
#
#   APP_URL=https://edutest.agtci.com
#
APP_URL=https://dev.bkesari.com/edu

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# PostgreSQL (the only supported database). Requires the pdo_pgsql PHP extension.
#
# On every bkesari.com tier the database is Neon (../docs/NEON.md): database
# `bk_edu`, owned by the login `bk_edu_app`, on that tier's Neon branch. The
# server's .env then holds that tier's two connection strings, pasted whole
# from the Neon console (Connect -> database bk_edu, role bk_edu_app),
# ?sslmode=require&channel_binding=require included, and nothing else from the
# DB_HOST..DB_SSLMODE block below:
#
#   DB_CONNECTION=pgsql
#   DB_URL=postgresql://bk_edu_app:<password>@ep-<id>-pooler.<region>.aws.neon.tech/bk_edu?sslmode=require&channel_binding=require
#   DB_URL_UNPOOLED=postgresql://bk_edu_app:<password>@ep-<id>.<region>.aws.neon.tech/bk_edu?sslmode=require&channel_binding=require
#
# DB_URL ("Connection pooling" on) is what the app uses while it runs.
# DB_URL_UNPOOLED ("Connection pooling" off) is used by `php artisan migrate`,
# `db:seed` and the other schema commands, automatically. Either one overrides
# the DB_* lines below. After changing them on a server, run
# `php artisan config:cache` again (or `optimize`): the cached copy is what the
# app reads.
#
# Locally, leave both unset and use the DB_* lines; tools/setup_local_postgres.sh
# (repo root) fills them in for you.
DB_CONNECTION=pgsql
DB_URL=
DB_URL_UNPOOLED=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bk_edu
DB_USERNAME=bk_edu
DB_PASSWORD=
DB_SSLMODE=prefer

# Education's own sign-in. The session cookie is `edu_sid`, HttpOnly,
# SameSite=Lax, sent only to the path of APP_URL (/edu behind the hub) and
# Secure when APP_URL is https. Leave SESSION_COOKIE, SESSION_PATH and
# SESSION_SECURE_COOKIE unset so they follow APP_URL.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Mail: Hostinger's SMTP on every tier, the same mailbox settings as the other
# bkesari apps. It carries the one-time sign-in codes (SMS is on hold), password
# resets and invitations. Port 465 is implicit TLS, which Laravel calls
# MAIL_SCHEME=smtps. MAIL_USERNAME is the whole mailbox address, and
# MAIL_FROM_ADDRESS should be that same mailbox (Hostinger may refuse, or mark
# as spam, mail from another sender). MAIL_PASSWORD is the mailbox's password
# from hPanel -> Emails; it lives only in the server's .env, never here.
#
# When is a sign-in code shown on screen instead? Only when APP_ENV is local or
# dev AND nothing delivers mail (MAIL_MAILER=log or array). On test, production
# or any other APP_ENV it never is: with no working mailer there the screen says
# the code could not be sent and to use the password. Locally, MAIL_MAILER=log
# with APP_ENV=local shows it.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@bkesari.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@bkesari.com"
MAIL_FROM_NAME="Education · bkesari"
# Seconds to wait for the mail server: codes are sent while the person waits.
MAIL_TIMEOUT=15

VITE_APP_NAME="${APP_NAME}"

# The Kesari design system and the bkesari app shell (/kesari-ui/..., and
# /shared/menu.js) are served by the hub. Behind the hub leave this empty (same
# origin); a copy reached directly, not through bkesari.com, sets it to
# https://bkesari.com.
HUB_ASSET_ORIGIN=

# Mobile sign-in by one-time code: ON HOLD (owner's decision, 4 Nov 2026), so
# leave both unset. The sign-in screen offers a code by text message only when
# SMS_WEBHOOK_URL is set; people sign in with a code by email or a password.
# The provider's webhook receives a POST of {"to":"+91XXXXXXXXXX","text":"..."}
# with "Authorization: Bearer <token>".
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
