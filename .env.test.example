# Copy to .env.test (gitignored) to run the database tests against a real MySQL:
#
#   cp .env.test.example .env.test
#   npm run test:mysql
#
# Without this file, `npm test` still runs: the SQLite half of
# tests/db-dialects.test.js needs no server, and the MySQL half skips itself
# with a reason. This file is what turns the MySQL half on.
#
# These are deliberately TEST_MYSQL_* and not the DB_* names the app reads.
# The tests DELETE every row in the four tracker tables before each case, so
# they must not be able to pick up a database from a developer's .env by
# accident. Setting DB_NAME does nothing here; only these names count.

# Must be a THROWAWAY database. Defaults below match the local devstack
# (`devstack up`), which serves MySQL on 127.0.0.1:3307.
TEST_MYSQL_HOST=127.0.0.1
TEST_MYSQL_PORT=3307
TEST_MYSQL_NAME=bkesari_platform_test
TEST_MYSQL_USER=kesari
TEST_MYSQL_PASSWORD=devstack-local-only

# Postgres (Neon runs Postgres). A THROWAWAY database too: the same tests empty
# the four tracker tables. Never point this at the Neon branch's DATABASE_URL.
# TEST_PG_URL=postgres://user:password@127.0.0.1:5432/bkesari_platform_test
