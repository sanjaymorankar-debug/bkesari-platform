# Copy to .env.test (gitignored) to run the PostgreSQL tests with the rest:
#
#   cp .env.test.example .env.test     # then put your test database's password in
#   npm run test:pg                    # the whole suite, nothing skipped
#
# Without it, `npm test` still runs: the tests that need PostgreSQL skip
# themselves and say so. CI sets TEST_DATABASE_URL itself.
#
# Deliberately TEST_DATABASE_URL, not the DATABASE_URL / DB_* names the app
# reads: the tests DROP and refill the tracker tables, so they must not be
# able to pick up a real database from a .env by accident.
#
# Must be a THROWAWAY local database, never Neon. tools/setup_local_postgres.sh
# creates bk_portal_test and writes this same line, with the password, into .env.
TEST_DATABASE_URL=postgresql://bk_portal:change-me@127.0.0.1:5432/bk_portal_test
