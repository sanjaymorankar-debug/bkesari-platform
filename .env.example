# Copy these into Hostinger hPanel -> Node.js Web App -> Environment variables
# (or export them locally). Nothing here is read from a file automatically.

PORT=3000
# Hostinger sets PORT itself; you normally do not need to.

# --- Database ---------------------------------------------------------------
# mysql  -> production on Hostinger (create the DB in hPanel, run sql/mysql_schema.sql in phpMyAdmin)
# sqlite -> local use; a single file, needs no server (uses Node's built-in node:sqlite)
DB_CLIENT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_tasks
DB_USER=u123456789_tasks
DB_PASSWORD=change-me

# Only used when DB_CLIENT=sqlite
SQLITE_PATH=./data/tasks.db   # relative to portal/

# --- Task Tracker login -----------------------------------------------------
# If both are set, /tasks asks for this username/password (HTTP Basic auth).
# Leave unset ONLY for local use - otherwise anyone on the internet can edit tasks.
TRACKER_USER=admin
TRACKER_PASSWORD=change-me

# --- ATIP read-only dashboard (/atip/) ---------------------------------------
# Login for viewing. If unset, /atip/ refuses everyone (it never opens up by default).
ATIP_USER=viewer
ATIP_PASSWORD=change-me
# Shared secret the ATIP machine uses to upload snapshots. Generate a long random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a DIFFERENT value on bkesari.com and test.bkesari.com.
ATIP_PUBLISH_TOKEN=change-me

# --- Serving the other projects under their tab paths ------------------------
# The menu's tabs are paths (/milk/, /edu/, /ladwani/), but those projects are
# separate applications on their own Hostinger sites. Set a tab's origin and
# the hub forwards that path to it; leave it blank and the tab keeps showing
# the "not on this tier yet" page. See DEPLOY.md Part 7.
#
# A bare origin only — no path, query or credentials. The prefix is forwarded
# unchanged, so the app behind it must serve itself under that prefix
# (Next.js basePath, Laravel APP_URL).
#
# Point these at the SAME TIER. A dev hub forwarding to a production app would
# put production data behind a dev URL.
MILK_ORIGIN=
EDU_ORIGIN=
LADWANI_ORIGIN=

# --- Central login (portal/auth, docs/auth/DESIGN.md) -------------------------
# Off unless AUTH_ENABLED=1. Off, the hub behaves exactly as before (Basic auth
# on /tasks/ and /atip/). On, /auth/ serves sign-in, the admin panel and the
# OpenID provider for agtci.com, and the hub gates every project tab.
# One set per tier (dev / test / prod), each with its OWN secrets. Never commit
# real values; keep them in hPanel's environment variables or a server-side
# .env.dev / .env.test / .env.prod that is not in Git.
AUTH_ENABLED=
# The public origin of this tier, no trailing slash. The OIDC issuer is <this>/auth.
AUTH_PUBLIC_URL=https://dev.bkesari.com
# 32+ random characters. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# RSA key for signing ID tokens: npm run auth -- keygen  (paste the one-line form)
AUTH_OIDC_PRIVATE_KEY=
# The owner: the only account that can ever be SUPER_ADMIN and open ATIP.
AUTH_OWNER_EMAIL=
# Where the auth tables live. Each falls back to the DB_* value above; point
# these at the main (Milk & Dairy) database to keep identity there.
AUTH_DB_CLIENT=
AUTH_DB_HOST=
AUTH_DB_PORT=
AUTH_DB_NAME=
AUTH_DB_USER=
AUTH_DB_PASSWORD=
# Which project tabs the hub gates (default: milk,edu,ladwani,tasks). Roll out one at a time.
AUTH_GATE_TABS=
# Google sign-in (optional). Redirect URI to register: <AUTH_PUBLIC_URL>/auth/google/callback
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
# Mail for verification and password-reset links. Without it, dev prints links
# to the log; test and prod cannot send them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Rarely needed: cookie name/domain overrides (default __Host-bk_sso, host-only).
AUTH_COOKIE_NAME=
AUTH_COOKIE_DOMAIN=
