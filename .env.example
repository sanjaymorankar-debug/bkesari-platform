# Copy these into Hostinger hPanel -> Node.js Web App -> Environment variables,
# or the site's .env. Locally: node --env-file=.env portal/server.js
# (plain `npm start` reads no file).

PORT=3000
# Hostinger sets PORT itself; you normally do not need to.

# --- Database: PostgreSQL on Neon --------------------------------------------
# The portal uses the default database `neondb`, as role `bk_portal_app`, on the Neon
# branch of this tier: production -> bkesari.com, test -> test.bkesari.com,
# dev -> dev.bkesari.com. docs/NEON.md has the layout and how to create it.
# This site's .env holds ONLY this tier's two strings. The app creates its own
# tables on start (portal/sql/schema.sql), once the `neondb` block of the
# tier's .sql file (docs/NEON.md, step 3) has let bk_portal_app create them.
#
# Neon console -> the branch -> Connect -> database `neondb`, role `bk_portal_app`:
#   "Connection pooling" ON  -> DATABASE_URL           (host has -pooler in it)
#   "Connection pooling" OFF -> DATABASE_URL_UNPOOLED  (used to create the tables)
# Paste them as given: ?sslmode=require&channel_binding=require is what turns
# TLS on, so DB_SSL is not needed with them.
DATABASE_URL=postgresql://bk_portal_app:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://bk_portal_app:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
#
# A local PostgreSQL instead (tools/setup_local_postgres.sh writes these): drop
# the two lines above and use the parts. DATABASE_URL wins when both are set.
#   DB_HOST=127.0.0.1
#   DB_PORT=5432
#   DB_NAME=bk_portal
#   DB_USER=bk_portal
#   DB_PASSWORD=change-me
# TLS for the parts, or for a URL without sslmode:
#   DB_SSL=require     verify the server certificate
#   DB_SSL=no-verify   encrypt but skip verification (only if your provider says so)

# --- Task Tracker login -----------------------------------------------------
# If both are set, /tasks asks for this username/password (HTTP Basic auth).
# Leave unset ONLY for local use - otherwise anyone on the internet can edit tasks.
TRACKER_USER=admin
TRACKER_PASSWORD=change-me

# --- ATIP read-only dashboard (/atip/) ---------------------------------------
# Login for viewing. If unset, /atip/ refuses everyone (it never opens up by default).
ATIP_USER=viewer
ATIP_PASSWORD=change-me
# Shared secret the ATIP machine uses to upload snapshots. Generate a long random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a DIFFERENT value on bkesari.com and test.bkesari.com.
ATIP_PUBLISH_TOKEN=change-me

# --- Serving the other projects under their tab paths ------------------------
# The menu's tabs are paths (/ladwani/, /edu/, /tasklist/), but those projects are
# separate applications on their own Hostinger sites. Set a tab's origin and
# the hub forwards that path to it; leave it blank and the tab keeps showing
# the "not on this tier yet" page. See DEPLOY.md Part 7.
#
# A bare origin only — no path, query or credentials. The prefix is forwarded
# unchanged, so the app behind it must serve itself under that prefix
# (Next.js basePath, Laravel APP_URL).
#
# Point these at the SAME TIER. A dev hub forwarding to a production app would
# put production data behind a dev URL.
#
# Left blank, APP_ENV=dev|test|production fills in that tier's Hostinger site
# (TIER_ORIGINS in portal/proxy.js). With no APP_ENV nothing is filled in.
EDU_ORIGIN=
LADWANI_ORIGIN=
# TaskList (the TaskList repository), e.g. http://127.0.0.1:3100 locally.
# Setting it also redirects the old /tasks/ address to /tasklist/. TaskList
# has its own login (TASKLIST_USER / TASKLIST_PASSWORD in ITS .env); with
# NEON_AUTH_BASE_URL set the hub also asks for a bkesari ID with TaskList access.
TASKLIST_ORIGIN=

# --- LadWani, served by this process at /ladwani/ (portal/ladwani.js) ------------
# Used when the build is present (npm run build:hostinger builds it into
# ladwani/). LADWANI_DATABASE_URL: Neon bkesari-ladwani, the tier's branch,
# database bk_ladwani, pooled. LADWANI_JWT_SECRET is optional: unset, it is
# derived from HUB_TOKEN_PRIVATE_KEY. Locally, a scratch database only.
LADWANI_DATABASE_URL=
LADWANI_JWT_SECRET=

# --- Neon (neon.ts) ------------------------------------------------------------
# `neon deploy --env .env.local` provisions the services in neon.ts and writes
# their variables to .env.local (git-ignored). On a host, copy them into its
# environment. Each service below is off until its variables are present.
# DEPLOY.md Part 8 has the details.
#
# Postgres: DATABASE_URL (pooled, for the app) and DATABASE_URL_UNPOOLED (the
# schema bootstrap), set in the Database section above.
#
# Neon Auth replaces the TRACKER_USER/TRACKER_PASSWORD login on /tasks/ when
# NEON_AUTH_BASE_URL is set. Only verified accounts on this list get in;
# an empty list admits nobody, because anyone can create an account.
#   NEON_AUTH_BASE_URL, NEON_AUTH_JWKS_URL        (from neon deploy)
NEON_AUTH_COOKIE_SECRET=
# ^ not from Neon: 32+ characters, `openssl rand -base64 32`
TRACKER_ALLOWED_EMAILS=
#
# Realtime (the dashboard updates live): NEON_REALTIME_URL, NEON_REALTIME_SECRET
#
# Object storage (ATIP snapshot archive, bucket "assets"): AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY, AWS_ENDPOINT_URL_S3, AWS_REGION. If the host already
# exports AWS_* variables for something else, those win over a .env file; set
# Neon's in the host's own environment instead.
#
# The `report` function: NEON_FUNCTION_REPORT_BASE_URL (from neon deploy) and
# ORIGIN_SECRET, which is not from Neon. The same value goes in .env.local
# before `neon deploy --env .env.local`, which uploads it to the function.
ORIGIN_SECRET=
