# Copy these into Hostinger hPanel -> Node.js Web App -> Environment variables
# (or export them locally). Nothing here is read from a file automatically.

PORT=3000

# --- Database ---------------------------------------------------------------
# mysql  -> production on Hostinger (create the DB in hPanel, run sql/mysql_schema.sql in phpMyAdmin)
# sqlite -> local use; a single file, needs no server (uses Node's built-in node:sqlite)
DB_CLIENT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_tasks
DB_USER=u123456789_tasks
DB_PASSWORD=change-me

# Only used when DB_CLIENT=sqlite
SQLITE_PATH=./data/tasks.db

# --- Task Tracker login -----------------------------------------------------
# If both are set, /tasks asks for this username/password (HTTP Basic auth).
# Leave unset ONLY for local use - otherwise anyone on the internet can edit tasks.
TRACKER_USER=admin
TRACKER_PASSWORD=change-me
